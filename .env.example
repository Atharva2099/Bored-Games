# URL of the Cloudflare Worker that mints TURN credentials (see worker/).
# Vite inlines this at BUILD time, so it must be set before `npm run build`
# / `npm run deploy`. Leave unset to build with TURN disabled.
VITE_TURN_ENDPOINT=https://bored-games-turn.<your-subdomain>.workers.dev

# Which transport the game uses. 'ws' (default) talks to the WebSocket
# relay (room-worker/, a Cloudflare Durable Object) in a star topology and
# needs no TURN/NAT traversal at all. 'p2p' forces the original Trystero
# WebRTC mesh (see VITE_TURN_ENDPOINT above) as a fallback.
VITE_TRANSPORT=ws

# Base URL of the room-worker Cloudflare Worker (see room-worker/README.md
# to deploy it). Required for VITE_TRANSPORT=ws. If left unset, the app
# still builds and runs — it just falls back to the Trystero (p2p) path.
VITE_ROOM_ENDPOINT=https://bored-games-room.<your-subdomain>.workers.dev
